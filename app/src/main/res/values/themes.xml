<resources>
    <!-- Near-black, OLED friendly. Window/system bars match the app background so no grey ever shows. -->
    <style name="Theme.App" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/ct_bg</item>
        <item name="android:colorBackground">@color/ct_bg</item>
        <item name="android:statusBarColor">@color/ct_bg</item>
        <item name="android:navigationBarColor">@color/ct_bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
